{
  "name": "owl-hours",
  "productName": "Owl Hours",
  "version": "2.0.0",
  "description": "Your Kennesaw State coursework in one place.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder --mac --win"
  },
  "build": {
    "appId": "edu.kennesaw.owlhours",
    "productName": "Owl Hours",
    "copyright": "Owl Hours",
    "directories": {
      "output": "../dist",
      "buildResources": "build"
    },
    "files": [
      "*.js",
      "app/**/*",
      "build/icon.png"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "artifactName": "Owl-Hours-${version}-${arch}-mac.${ext}"
    },
    "dmg": {
      "title": "Owl Hours",
      "writeUpdateInfo": false,
      "artifactName": "Owl-Hours-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "afterPack": "build/adhoc-sign.js",
    "electronVersion": "33.4.11",
    "publish": [
      {
        "provider": "github",
        "owner": "Unknownce0",
        "repo": "owl-hours"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Owl-Hours-Windows-${version}-Setup.${ext}"
    }
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
